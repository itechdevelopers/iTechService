# Rails shared .env
AIS_MCP_ENABLED=0
AIS_MCP_PUBLIC_ORIGIN=https://ise.itech.pw
AIS_MCP_OAUTH_CLIENT_ID=ais-chatgpt-work
# Exact HTTPS callback(s) shown by ChatGPT plugin setup; comma separated. No wildcards.
AIS_MCP_OAUTH_REDIRECT_URIS=
# Node systemd EnvironmentFile (separate from Rails shared .env)
AIS_MCP_BACKEND_ORIGIN=https://ise.itech.pw
AIS_MCP_PORT=3101
