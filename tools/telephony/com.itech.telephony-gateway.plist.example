<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.itech.telephony-gateway</string>
<key>ProgramArguments</key><array><string>/bin/sh</string><string>/PRIVATE/start-mac-gateway.sh</string></array>
<key>EnvironmentVariables</key><dict><key>AIS_TELEPHONY_VM_WRAPPER</key><string>/PRIVATE/vm.sh</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>30</integer>
</dict></plist>
