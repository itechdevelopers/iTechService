<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.itech.telephony-live</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/python3</string><string>/PRIVATE/live_history.py</string><string>--config</string><string>/PRIVATE/live.json</string></array>
<key>KeepAlive</key><true/>
<key>RunAtLoad</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>EnvironmentVariables</key><dict>
<key>SSL_CERT_FILE</key><string>/etc/ssl/cert.pem</string>
<key>LANG</key><string>C</string><key>LC_ALL</key><string>C</string>
<key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
</dict>
<key>StandardOutPath</key><string>/PRIVATE/live-history.log</string>
<key>StandardErrorPath</key><string>/PRIVATE/live-history-error.log</string>
</dict></plist>
