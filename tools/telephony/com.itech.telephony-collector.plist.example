<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.itech.telephony-collector</string>
<key>ProgramArguments</key><array><string>/PRIVATE/python3</string><string>/PRIVATE/collector.py</string><string>--config</string><string>/PRIVATE/collector.json</string></array>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>60</integer>
</dict></plist>
