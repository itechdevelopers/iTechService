# Every environment variable the application reads, with empty values.
#
# This file is the reference list, not a working config. Copy the keys you need:
#   production — /var/www/itechservice/shared/.env, symlinked into each release
#   development — .env.development.local (see .env.development.local.example)
#
# Variables of the run itself (RAILS_ENV, BUNDLE_GEMFILE, DEPLOY_REF and such)
# are deliberately absent: they belong to the shell that starts the process.

SECRET_KEY_BASE=
DEVISE_SECRET_KEY=
SERVER_HOST=
EMAIL_SENDER=

# Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_NAME_TEST=

# Sidekiq
SK_REDIS_URL=

# Outgoing mail
SMTP_SERVER=
SMTP_PORT=
SMTP_DOMAIN=
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=

# Mailbox the sales import reads reports from
SALES_EMAIL_HOST=
SALES_EMAIL_LOGIN=
SALES_EMAIL_PASSWORD=

# 1C. ONE_C_MOCK_MODE=true answers from fixtures and needs no credentials
ONE_C_API_USERNAME=
ONE_C_API_PASSWORD=
ONE_C_MOCK_MODE=

# Find My device checks. FIND_MY_HEALTHCHECK_IMEI is any IMEI the service can
# resolve — the daily check only proves the service answered at all
FIND_MY_API_URL=
FIND_MY_API_KEY=
FIND_MY_SERVICE_ID=
FIND_MY_MOCK_MODE=
FIND_MY_HEALTHCHECK_IMEI=

# WhatsApp
GREEN_API_BASE_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# SMS gateway
GOIP_USERNAME=
GOIP_PASSWORD=

# Telegram bots: the employee one and the client one. Each bot is registered
# only when its token is set, so an empty token disables that bot alone
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
CLIENT_TELEGRAM_BOT_TOKEN=

# MAX bot the clients write to. Same rule as above: no token, no bot.
# The webhook subscription is registered separately via the MAX API and
# carries its own secret, sent back in the X-Max-Bot-Api-Secret header
CLIENT_MAX_BOT_TOKEN=
CLIENT_MAX_WEBHOOK_SECRET=
# The API moved to platform-api.max.ru and accepts the token only in the
# Authorization header; the base URL stays configurable in case it moves again
CLIENT_MAX_API_URL=

# Group chats the bot posts to. A chat has no employee behind it, so these
# messages bypass NotificationDispatcher and personal notification settings
TELEGRAM_SCHEDULE_CHAT_ID=
TELEGRAM_SCHEDULE_CONFLICT_CHAT_ID=
TELEGRAM_GLASS_STICKING_CHAT_ID=
TELEGRAM_DEVICE_TESTING_CHAT_ID=
REPAIR_GLUING_TELEGRAM_CHAT_ID=
REPAIR_ATTENTION_TELEGRAM_CHAT_ID=

# Uploads (S3-compatible storage)
AWS_HOST=
AWS_PORT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# SFTP the call recordings are played back from
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=

# Bearer token the markup/iPhone dashboards accept imports with. On production
# it is read from config/weekly_markup_import_token when the variable is unset
WEEKLY_MARKUP_IMPORT_TOKEN=

# Identify the installation for db/seeds.rb
DEPARTMENT_CODE=
DEPARTMENT_NAME=

# Puma and asset serving
PORT=
WEB_CONCURRENCY=
RAILS_MAX_THREADS=
RAILS_SERVE_STATIC_FILES=
RAILS_LOG_TO_STDOUT=
