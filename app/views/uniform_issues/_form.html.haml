= simple_form_for @uniform_operation, url: uniform_issues_path, html: { class: 'form-horizontal' } do |f|
  = f.error_notification message: error_messages_for(@uniform_operation)

  - if @return_kind_id
    = hidden_field_tag :uniform_kind_id, @return_kind_id

  -# Тот же пикер, что в плюсах-минусах: поиск по подстрокам и подсветка опций
  -# цветом. Цвет берём от локации, а где его нет — от подразделения.
  = f.input :recipient_id, as: :custom_select, searchable: true,
    collection: uniform_recipients_collection,
    label_method: :short_name_with_location, color_method: :location_or_department_color,
    prompt: t('.select_employee'), search_placeholder: t('.search_placeholder'),
    label: UniformOperation.human_attribute_name(:recipient)

  = f.input :performed_on, as: :my_date
  = f.input :comment, input_html: { rows: 2 }

  - @uniform_kinds.each do |uniform_kind|
    %fieldset
      %legend= uniform_kind.name
      %table.table.table-bordered.table-condensed.uniform-operations__lines
        %thead
          %tr
            %th= UniformStock.human_attribute_name :size
            %th= t('.in_stock')
            %th= UniformOperationLine.human_attribute_name :quantity
        %tbody
          - uniform_kind.uniform_stocks.each do |stock|
            - index, line = @form_lines[stock.id]
            = f.simple_fields_for :uniform_operation_lines, line, child_index: index do |ff|
              %tr
                %td= stock.label
                %td= stock.quantity
                %td
                  = ff.hidden_field :uniform_stock_id
                  = ff.input :quantity, label: false, input_html: { class: 'input-mini' }

  .form-actions
    = f.submit t('.submit'), class: 'btn btn-primary'
    = link_to t('helpers.links.cancel'), (@return_kind_id ? uniform_kind_path(@return_kind_id) : uniform_kinds_path),
      class: 'btn'
