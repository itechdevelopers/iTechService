<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Телефон АИС</title><%= csrf_meta_tags %><%= stylesheet_link_tag 'telephony/phone' %>
<%= javascript_include_tag 'telephony/jssip.min', defer: true %><%= javascript_include_tag 'telephony/phone', defer: true %>
</head><body class="<%= params[:embedded] == '1' ? 'embedded' : 'standalone' %>"><main id="ais-phone" data-extension="<%= current_user.telephony_extension %>">
<h1>Телефон · <%= current_user.telephony_extension %></h1>
<details id="phone-settings" open><summary>Подключение и микрофон</summary>
<input type="hidden" id="identity" value="<%= current_user.telephony_extension %>">
<label for="microphone">Микрофон</label><select id="microphone"><option value="">Системный по умолчанию</option></select>
<div class="actions"><button id="enable">Включить телефонию</button><button id="disable" disabled>Выключить</button></div>
<p class="hint">Разрешите микрофон и, если браузер запросит, доступ АИС к локальной сети.</p>
</details>
<ul id="phone-checks" aria-label="Проверка телефонии"><li id="check-microphone">Микрофон: не проверен</li><li id="check-gateway">Шлюз: не проверен</li><li id="check-registration">Регистрация: выключена</li></ul>
<p id="gateway-help" hidden><a id="gateway-check" target="_blank" rel="noopener">Проверить защищённое соединение со шлюзом</a></p>
<p id="status" role="status">Телефония выключена</p><p id="error" role="alert"></p>
<section><p id="original-caller" class="hint" hidden></p><h2 id="call-title">Нет активного звонка</h2><p id="duration">00:00</p>
<button id="call-reference" class="call-reference" type="button" hidden></button><span id="reference-feedback" class="hint" role="status"></span>
<div id="caller-context" hidden></div>
<div class="actions"><button id="answer" disabled>Ответить</button><button id="reject" disabled>Отклонить</button><button id="hangup" disabled>Завершить</button><button id="hold-call" type="button" aria-pressed="false" disabled>Удержать</button><button id="mute" disabled>Выключить микрофон</button></div>
<p id="hold-status" role="status"></p>
<div id="consult-panel" hidden><strong>Клиент остаётся на удержании</strong><p id="consult-title" role="status"></p><button id="consult-reference" class="call-reference" type="button" hidden></button>
<button id="consult-return" type="button">Завершить консультацию и вернуться</button><button id="consult-connect" type="button" disabled>Соединить клиента с коллегой</button></div>
<p id="consult-result" role="status"></p>
<label for="target">Кому позвонить</label><input id="target" type="tel" placeholder="Номер телефона или внутренний номер" autocomplete="off"><button id="test-call" disabled>Позвонить</button>
<button id="directory-open" type="button" aria-expanded="false" aria-controls="phone-directory">Адресная книга</button>
<div id="phone-directory" hidden>
  <label for="directory-search">Поиск по номеру, подписи или адресу</label><input id="directory-search" type="search" autocomplete="off">
  <p id="directory-status" role="status"></p><div id="directory-list"></div>
</div>
<div id="transfer-panel" hidden>
  <label for="transfer-target">Перевести разговор на внутренний номер</label><input id="transfer-target" type="tel" placeholder="Например, 104" autocomplete="off">
  <button id="transfer-directory" type="button">Выбрать из адресной книги</button><button id="transfer-call" type="button" disabled>Перевести звонок</button>
  <p class="hint">Прямой перевод без предварительного разговора с получателем.</p><p id="transfer-status" role="status"></p>
</div>
<audio id="remote" autoplay playsinline></audio><button id="play-audio">Включить звук</button>
<details id="phone-meters" open><summary>Уровни микрофона и собеседника</summary>
<label>Микрофон</label><div id="mic-meter" class="meter-bars" role="meter" aria-label="Уровень микрофона" aria-valuemin="0" aria-valuemax="100"></div><p id="mic-meter-hint"></p>
<label>Собеседник</label><div id="remote-meter" class="meter-bars" role="meter" aria-label="Уровень собеседника" aria-valuemin="0" aria-valuemax="100"></div>
</details>
<details><summary>Состояние звука</summary><p id="mic-status"></p><p id="audio-status"></p><p id="rtp-status"></p></details>
</section><p><a href="<%= phone_calls_path %>" target="_blank" rel="noopener">История вызовов</a></p>
</main></body></html>
