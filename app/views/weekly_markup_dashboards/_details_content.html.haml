- if @dashboard[:update_failed]
  .alert.alert-error
    Последнее обновление не выполнено. Показана предыдущая успешная версия.
- if @dashboard[:missing_dates].any?
  .alert.alert-warning
    Нет загруженных данных: #{@dashboard[:missing_dates].map { |date| l(date) }.join(', ')}.
- if @dashboard[:incomplete_dates].any?
  .alert.alert-warning
    Неполный день: #{@dashboard[:incomplete_dates].map { |date| l(date) }.join(', ')}. Данные актуальны на #{@dashboard[:as_of_local]}.
- if @dashboard[:zero_cost_revenue_dates].any?
  .alert.alert-error
    В 1С ещё не рассчитана себестоимость за даты: #{@dashboard[:zero_cost_revenue_dates].map { |date| l(date) }.join(', ')}. Прибыль, маржа и наценка периода предварительные.
- elsif @dashboard[:preliminary_cost_dates].any?
  .alert.alert-error
    В выбранном периоде есть товары с незавершённым расчётом себестоимости. Наценка предварительная и станет актуальной после закрытия месяца и повторного расчёта.

= form_tag details_weekly_markup_dashboard_path, method: :get, class: 'form-inline weekly-markup-filter' do
  = label_tag :from, 'Период с'
  = date_field_tag :from, @period_from, required: true
  = label_tag :to, 'по'
  = date_field_tag :to, @period_to, required: true
  = submit_tag 'Показать', class: 'btn btn-primary'
  = link_to 'JSON', download_weekly_markup_dashboard_path(from: @period_from, to: @period_to, format: :json), class: 'btn'
  = link_to 'CSV', download_weekly_markup_dashboard_path(from: @period_from, to: @period_to, format: :csv), class: 'btn'

%h3 Наценка по месяцам
.monthly-markup-tiles
  - @dashboard[:months].each do |month|
    - state_class = month[:partially_closed] ? 'monthly-markup-tile--partial' : month[:closed] ? 'monthly-markup-tile--closed' : 'monthly-markup-tile--preliminary'
    .monthly-markup-tile{class: state_class, title: month[:status]}
      .monthly-markup-tile__month= l(month[:from], format: '%B %Y').capitalize
      .monthly-markup-tile__value= markup_percent(month[:totals][:markup])
%p.monthly-markup-tiles__legend
  %span.monthly-markup-tiles__legend-swatch.monthly-markup-tiles__legend-swatch--partial
  Оранжевый — месяц закрыт, но не до конца.

%h3 Операции, исключённые из расчёта рентабельности
%p.muted Эти операции учитываются в полном обороте и оплатах, но не входят в выручку, прибыль, валовую маржу и наценку ниже.
%p.muted Количество операций — число строк регистра с положительной выручкой за вычетом строк с отрицательной выручкой. Строки с нулевой выручкой не учитываются. Это не количество посещений клиентов; исходное количество из 1С сохраняется в JSON.
%table.table.table-bordered.weekly-markup-excluded-operations
  %thead
    %tr
      %th Код
      %th Операция
      %th Количество операций
      %th Сумма
  %tbody
    - @dashboard[:excluded_operations][:rows].each do |operation|
      %tr
        %td= operation[:code]
        %td= operation[:name]
        %td= markup_quantity(operation[:operation_count])
        %td= markup_money(operation[:amount])
  %tfoot
    %tr
      %th{colspan: 2} Итого исключено
      %th= markup_quantity(@dashboard[:excluded_operations][:operation_count])
      %th= markup_money(@dashboard[:excluded_operations][:amount])

- totals = @dashboard[:totals]
.weekly-markup-cards
  - [['Выручка', :revenue], ['Себестоимость', :cost], ['Прибыль до налога с Б/Н', :gross_profit_before_tax], ['Налог с Б/Н (10%)', :noncash_tax], ['Прибыль после налога', :gross_profit], ['Наличные', :cash], ['Безналичные', :noncash], ['Не распределено', :unallocated]].each do |label, key|
    .weekly-markup-card
      .weekly-markup-card__label= label
      .weekly-markup-card__value= markup_money(totals[key])
  .weekly-markup-card.weekly-markup-card--ratio
    .weekly-markup-card__label Маржа после налога
    .weekly-markup-card__value= markup_percent(totals[:gross_margin])
  .weekly-markup-card.weekly-markup-card--ratio
    .weekly-markup-card__label Наценка после налога
    .weekly-markup-card__value= markup_percent(totals[:markup])
  .weekly-markup-card.weekly-markup-card--ratio
    .weekly-markup-card__label Доля наличных
    .weekly-markup-card__value= markup_percent(totals[:cash_share])
%p.muted Наличные, безналичные и нераспределённые показывают полный оборот, включая вынесенные выше операции.

