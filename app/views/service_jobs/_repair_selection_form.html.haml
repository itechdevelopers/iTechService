.repair-selection-container{data: {product_id: product_id, department_id: department_id, field_name: f.object_name}}
  %h5
    %i.icon-wrench
    Выбор ремонта
    %button.btn.btn-mini.btn-success.add-repair-block-btn{type: 'button', style: 'margin-left: 10px;'}
      %i.icon-plus.icon-white
    %button.btn.btn-mini.choose-repair-group-btn{type: 'button', style: 'margin-left: 6px;'} Выбрать вид ремонта

  -# Разово для этой приёмки, справочник не меняется: когда вид ремонта у продукта
  -# задан неверно или не задан, причины подтягиваются от выбранного здесь.
  .control-group.repair-group-select-group{style: 'display:none;'}
    %label Вид ремонта для этого устройства
    = select_tag nil,
      options_for_select(intake_repair_group_options),
      class: 'repair-group-select form-control',
      prompt: 'Как в справочнике'
    -# Уходит на сервер только ради уведомления суперадминам. Пустое при каждой
    -# отрисовке: после ошибки валидации выбор вида ремонта в блоке тоже сброшен.
    = hidden_field_tag "#{f.object_name}[chosen_repair_group_id]", nil, id: nil, class: 'chosen-repair-group-input'

  .repair-selection-blocks
    .repair-selection-block.well.well-small
      -# 1. Выбор группы причин
      .control-group.repair-cause-group-select-group
        %label Выбор причины ремонта
        = select_tag nil,
          options_for_select([]),
          class: 'repair-cause-group-select form-control',
          prompt: 'Выберите категорию'

      -# 2. Выбор причин (скрыто по умолчанию, multi-select)
      .control-group.repair-cause-select-group{style: 'display:none;'}
        %label Уточнение причин ремонта
        = select_tag "#{f.object_name}[expected_repair_cause_ids][]",
          options_for_select([]),
          class: 'repair-cause-select form-control',
          multiple: true,
          data: { placeholder: 'Выберите причины' }
        -# Галочки рисует JS по опциям скрытого select'а выше (renderRepairCauseCheckboxes)
        .repair-cause-checkboxes

      -# 3. Выбор вида ремонта (скрыто по умолчанию, radio buttons)
      .control-group.repair-service-select-group{style: 'display:none;'}
        %label Вид ремонта
        .repair-service-radio-list
          -# Radio buttons будут добавлены через JavaScript
        -# Радиокнопки сгруппированы по блоку и в параметры работы не попадают: ремонт блока
        -# отправляет это поле, поэтому у каждого блока свой ремонт, а на сервер приходят все.
        = hidden_field_tag "#{f.object_name}[expected_repair_service_ids][]", nil, id: nil, class: 'repair-service-selected-input'

      -# 4. Информация о цене и времени (скрыто по умолчанию)
      .repair-info.alert.alert-info{style: 'display:none;'}
        %p
          %strong Цена:
          %span.repair-price
        %p
          %strong Время:
          %span.repair-time

  -# Подходящих причин в справочнике нет — приёмщик пишет свои. Поле открывается только
  -# с отметкой, текст уходит в «Заявленный клиентом дефект» вместе с выбранными причинами
  -# и отдельно сохраняется в задаче: дефект потом правят руками, а здесь он остаётся как ввели.
  .manual-causes
    %label.checkbox
      = f.check_box :repair_causes_filled_manually, class: 'manual-causes-checkbox'
      Самостоятельно заполнено
    .control-group.manual-causes-group{style: ('display:none;' unless f.object.repair_causes_filled_manually)}
      %label Причины своими словами
      = f.text_area :manual_repair_causes, rows: 2, class: 'manual-causes-text input-xlarge',
        placeholder: 'Например: после падения не включается'
