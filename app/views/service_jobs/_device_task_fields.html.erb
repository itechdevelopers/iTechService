<tr class="device_task fields" data-task-id="<%= f.object.task_id %>">
  <td class="task_type">
    <%= f.input :task_id,
                as: :custom_select,
                collection: Task.visible.positioned,
                prompt: 'Выберите задачу',
                input_html: { class: 'device_task_task'},
                label: false %>
  </td>
  <% if intake_v2_task_table? %>
    <td class="task_repair">
      <%# Стоимость в новой приёмке не вводят руками: JS ставит цену задачи, а затем цену выбранного ремонта. %>
      <%= f.hidden_field :cost, class: 'device_task_cost' %>
      <div class="task-extended-content" style="display:none;">
        <%= render 'service_jobs/repair_selection_form',
                   f: f,
                   product_id: @service_job.item&.product_id,
                   department_id: @service_job.department_id %>
      </div>
      <%# Вне блока ремонта: комментарий нужен и задачам, которые не ремонт. %>
      <div class="task-comment">
        <%= f.label :comment, DeviceTask.human_attribute_name(:comment), class: 'task-comment__label' %>
        <%= f.text_area :comment, rows: 2, class: 'task-comment__input input-xlarge',
                        placeholder: 'Если нужно что-то уточнить' %>
      </div>
    </td>
  <% else %>
    <td class="task_cost">
      <%= f.number_field :cost, class: 'device_task_cost input-small' %>
    </td>
    <td class="task_comment">
      <%= f.text_area :comment, rows: 3, class: 'device_task_comment',
                      data: {content: raw(t('service_jobs.form.task_comment_hint'))} %>
    </td>
  <% end %>
  <td class="task_actions">
    <%= link_to_remove_fields f %>
  </td>
</tr>
