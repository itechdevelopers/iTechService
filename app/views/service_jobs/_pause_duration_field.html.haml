-# Быстрые кнопки только заполняют число и единицу — сервер читает
-# pause_amount и pause_unit, откуда бы они ни пришли. Обязательность
-# (required: true) проверяет сервер: HTML-атрибут подсвечивал бы поле
-# красным сразу при открытии окна, пока оно пустое и в фокусе.
- required = local_assigns.fetch(:required, false)
- label = local_assigns[:label] || t('service_jobs.repair_status.pause_duration.label')
- amount_id = "pause_amount_#{service_job.id}"
- unit_options = RepairPauseDuration::UNITS.keys.map { |unit| [t("service_jobs.repair_status.pause_duration.units.#{unit}"), unit] }

.repair-pause-duration
  %label.repair-status-widget-modal__label{ for: amount_id }
    = label
    - unless required
      %span.repair-pause-duration__optional= t('service_jobs.repair_status.pause_duration.optional')
  .repair-pause-duration__presets
    - unless required
      %button.repair-pause-duration__preset.repair-pause-duration__preset--active{ type: 'button', data: { pause_amount: '', pause_unit: 'hours' } }
        = t('service_jobs.repair_status.pause_duration.none')
    - RepairPauseDuration::PRESETS.each do |amount, unit|
      %button.repair-pause-duration__preset{ type: 'button', data: { pause_amount: amount, pause_unit: unit } }
        = t("service_jobs.repair_status.pause_duration.presets.#{unit}", count: amount)
  .repair-pause-duration__custom
    = number_field_tag :pause_amount, nil,
                       id: amount_id,
                       min: 1,
                       step: 1,
                       placeholder: t('service_jobs.repair_status.pause_duration.amount_placeholder'),
                       autocomplete: 'off',
                       class: 'repair-status-widget-modal__input repair-pause-duration__amount'
    = select_tag :pause_unit, options_for_select(unit_options, 'hours'),
                 class: 'repair-status-widget-modal__input repair-pause-duration__unit'
