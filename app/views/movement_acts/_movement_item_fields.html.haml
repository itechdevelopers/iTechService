%tr.movement_item_fields.fields{data: {item: f.object.item_id}}
  %td.num
  %td.product
    %strong= f.object.name
    - if f.object.try(:code).present?
      = link_to glyph(:barcode), '#', class: 'movement-act-items__code-toggle', title: Product.human_attribute_name(:code)
      .movement-act-items__code= f.object.code
    .features= features_presentation f.object
    = f.hidden_field :item_id
  - if can? :manage, MovementAct
    - store_quantities = movement_item_store_quantities(f.object)
    - movement_act_quantity_stores.each do |store|
      %td.store_quantity.number= store_quantities[store.id].to_i
    %td.available_quantity.number= f.object.try(:quantity_in_store, f.object.try(:store))
  %td.quantity= f.number_field :quantity, type: 'number', class: 'input-mini', min: 1, readonly: f.object.try(:feature_accounting)
  %td.action= link_to_remove_fields f