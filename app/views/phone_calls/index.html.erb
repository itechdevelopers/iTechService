<% content_for :title, 'История вызовов' %>
<h3>История вызовов</h3>
<%= form_tag phone_calls_path, method: :get, class: 'form-inline' do %>
  <%= text_field_tag :number, params[:number], placeholder: 'Телефон или внутренний номер' %>
  <%= submit_tag 'Найти', class: 'btn' %>
  <%= link_to 'Сбросить', phone_calls_path, class: 'btn' %>
<% end %>
<p>Все звонки АТС. Обновление каждые 2 секунды; итог и запись уточняются после завершения.</p>
<p id="call-history-warning" role="alert"></p>
<div id="call-history-live" data-refresh-url="<%= phone_calls_path(request.query_parameters.merge(fragment: '1')) %>">
  <%= render 'history' %>
</div>
<%= javascript_include_tag 'telephony/history' %>
