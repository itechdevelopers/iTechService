-# Переписки клиента в мессенджерах — блок на его карточке. Показываем только
-# тем, у кого есть доступ к разделу диалогов: содержимое переписки чувствительнее
-# списка ремонтов.
-#
-# Написать первым можно только по номеру — в MAX и WhatsApp через GREEN-API:
-# боты Telegram и MAX не умеют начинать переписку сами. Если открытый диалог в
-# канале уже есть, кнопка ведёт в него — без проверки номера в мессенджере.
-# Кнопка WhatsApp — только когда его инстанс подключён: иначе она вела бы в
-# «канал не настроен».
- channels = %w[max_phone]
- channels << 'whatsapp' if GreenApi::Channel.fetch('whatsapp').credentials.configured?
%h4
  = t('.title')
  - if policy(ClientConversation).start?
    .btn-group.pull-right
      - channels.each do |channel|
        - open = conversations.detect { |conversation| conversation.open? && conversation.channel == channel }
        - if open
          = link_to t(".open.#{channel}"), client_conversation_path(open), class: 'btn btn-small'
        - else
          = link_to t(".write.#{channel}"), new_client_chat_start_path(client, channel), remote: true, class: 'btn btn-small'
- if conversations.any?
  %table.table.table-bordered.table-hover.table-condensed
    %thead
      %tr
        %th= t('.started')
        %th= t('.channel')
        %th= t('.last_message')
        %th= t('.messages')
        %th= t('.status')
    %tbody
      - conversations.each do |conversation|
        %tr
          %td= link_to human_datetime(conversation.started_at || conversation.created_at), client_conversation_path(conversation)
          %td= t("client_conversations.conversation.channels.#{conversation.channel}", default: conversation.channel)
          %td= human_datetime conversation.last_message_at
          %td= conversation.messages.size
          %td
            - if conversation.open?
              %span.label.label-info= t('client_conversations.card.statuses.open')
            - else
              %span.label= t('client_conversations.card.statuses.closed')
- else
  %p.muted= t('.empty')
