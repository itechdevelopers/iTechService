-# Переписки клиента в мессенджерах — блок на его карточке. Показываем только
-# тем, у кого есть доступ к разделу диалогов: содержимое переписки чувствительнее
-# списка ремонтов.
-#
-# Написать первым можно только в MAX по номеру: боты Telegram и MAX не умеют
-# начинать переписку сами. Если открытый диалог там уже есть, кнопка ведёт в
-# него — без проверки номера в MAX.
- open_max = conversations.detect { |conversation| conversation.open? && conversation.channel == 'max_phone' }
%h4
  = t('.title')
  - if policy(ClientConversation).start?
    - if open_max
      = link_to t('.open_max'), client_conversation_path(open_max), class: 'btn btn-small pull-right'
    - else
      = link_to t('.write_max'), new_client_max_chat_path(client), remote: true, class: 'btn btn-small pull-right'
- if conversations.any?
  %table.table.table-bordered.table-hover.table-condensed
    %thead
      %tr
        %th= t('.started')
        %th= t('.channel')
        %th= t('.last_message')
        %th= t('.messages')
        %th= t('.status')
    %tbody
      - conversations.each do |conversation|
        %tr
          %td= link_to human_datetime(conversation.started_at || conversation.created_at), client_conversation_path(conversation)
          %td= t("client_conversations.conversation.channels.#{conversation.channel}", default: conversation.channel)
          %td= human_datetime conversation.last_message_at
          %td= conversation.messages.size
          %td
            - if conversation.open?
              %span.label.label-info= t('client_conversations.card.statuses.open')
            - else
              %span.label= t('client_conversations.card.statuses.closed')
- else
  %p.muted= t('.empty')
