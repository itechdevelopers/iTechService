-# Модалка «Написать первым». Поле сообщения появляется, только если номер
-# нашёлся в мессенджере; в остальных исходах объясняем, почему написать нельзя.
- found = !@limit_reached && @search&.found?
- names = { messenger: t("client_chat_starts.messengers.#{@channel.key}"), channel: @channel.title }
.modal-header
  = button_to_close_modal
  %h3= t('client_chat_starts.form.title', **names)

= form_tag client_chat_start_path(@client, @channel.key), remote: true do
  .modal-body
    %p
      = t('client_chat_starts.form.phone')
      %strong= @client.human_phone_number
    - if @limit_reached
      - limit = ClientChat::StartConversation.daily_limit(@channel.key)
      .alert= limit.zero? ? t('client_chat_starts.form.limit_zero', **names) : t('client_chat_starts.form.limit_reached', limit: limit, **names)
    - elsif found
      .alert.alert-success
        - if @search.name.present?
          = t('client_chat_starts.form.found_named', name: @search.name, **names)
        - else
          = t("client_chat_starts.form.found_unnamed.#{@channel.key}")
      - hint = t("client_chat_starts.form.hint.#{@channel.key}", default: '')
      - if hint.present?
        %p.muted= hint
      - if @result&.status == :empty_body
        .alert.alert-error= t('client_chat_starts.form.empty_body')
      = text_area_tag :body, @body, rows: 5, class: 'input-block-level', autofocus: true,
        placeholder: t('client_chat_starts.form.placeholder')
    - elsif @search.status == :not_found
      .alert
        - if @search.checked_at
          = t('client_chat_starts.form.not_found_on', date: l(@search.checked_at.to_date), **names)
        - else
          = t('client_chat_starts.form.not_found', **names)
    - elsif @search.status == :paused
      .alert.alert-error= t('client_chat_starts.form.paused', time: @search.retry_at.in_time_zone.strftime('%H:%M'), **names)
    - else
      .alert.alert-error= t("client_chat_starts.form.#{@search.status}", **names)
    -# Отправка не удалась уже после набора текста (кончился лимит, мессенджер
    -# ограничил проверки) — текст остаётся, чтобы его можно было скопировать.
    - if !found && @body.present?
      = text_area_tag :typed_body, @body, rows: 3, class: 'input-block-level', readonly: true

  .modal-footer
    - if found
      = submit_tag t('client_chat_starts.form.send'), class: 'btn btn-primary',
        data: { disable_with: t('client_chat_starts.form.sending') }
    = link_to t('helpers.links.close'), '#', 'data-dismiss' => 'modal', class: 'btn'
