-# Модалка «Новый диалог». Шаг 1 — кто: номер или клиент из подсказок. Шаг 2
-# (есть @reach) — где человек доступен; писать можно в один канал. У каждого
-# шага своя форма, обёрнутая вокруг тела и подвала модалки.
- scope = 'client_chat_starts.form'
.modal-header
  = button_to_close_modal
  %h3= t("#{scope}.title")

- if @reach.nil?
  = form_tag check_client_chat_starts_path, method: :get, remote: true do
    .modal-body
      %p.muted= t("#{scope}.who_hint")
      - if @who_error
        .alert.alert-error= t("#{scope}.who_invalid")
      .client-chat__client-picker{ data: { url: clients_client_chat_starts_path } }
        = text_field_tag :phone, @phone_input, class: 'input-xlarge client-chat__client-query', autofocus: true,
          placeholder: t("#{scope}.who_placeholder"), autocomplete: 'off'
        %ul.client-chat__client-results
    .modal-footer
      = submit_tag t("#{scope}.check"), class: 'btn btn-primary', data: { disable_with: t("#{scope}.checking") }
      = link_to t('helpers.links.close'), '#', 'data-dismiss' => 'modal', class: 'btn'
- else
  - available = @reach.available
  - selected = @selected.presence_in(available.map(&:channel)) || @reach.default_channel
  = form_tag client_chat_starts_path, remote: true do
    = hidden_field_tag :client_id, @reach.client&.id
    = hidden_field_tag :phone, @reach.phone
    .modal-body
      %p
        - if @reach.client
          = t("#{scope}.client")
          = link_to @reach.client.short_name, client_path(@reach.client), target: '_blank'
        = t("#{scope}.phone")
        %strong= @reach.phone ? "+#{@reach.phone}" : t("#{scope}.no_phone")
        - if @reach.client.nil?
          %span.muted= t("#{scope}.not_in_base")
        = link_to t("#{scope}.change"), new_client_chat_start_path, remote: true
      - if @result || @selected
        .alert.alert-error= chat_start_refusal(@result)
      - if available.empty?
        .alert= t("#{scope}.nowhere")
      - @reach.options.each do |option|
        %label.radio.client-chat-start__option
          = radio_button_tag :channel, option.channel, option.channel == selected, disabled: !option.available?
          = client_channel_label(option.channel)
          %span.muted= chat_start_option_status(option)
          - if option.status == :open
            = link_to t("#{scope}.statuses.open_link"), client_conversation_path(option.conversation), target: '_blank'
      - if available.any? { |option| option.channel == 'whatsapp' }
        %p.muted= t("#{scope}.whatsapp_hint")
      - if available.any?
        = text_area_tag :body, @body, rows: 4, class: 'input-block-level', placeholder: t("#{scope}.placeholder")
      - elsif @body.present?
        -# Отправить уже некуда (например, кончился лимит) — набранный текст
        -# остаётся, чтобы его можно было скопировать.
        = text_area_tag :typed_body, @body, rows: 3, class: 'input-block-level', readonly: true
    .modal-footer
      - if available.any?
        = submit_tag t("#{scope}.send"), class: 'btn btn-primary', data: { disable_with: t("#{scope}.sending") }
      = link_to t('helpers.links.close'), '#', 'data-dismiss' => 'modal', class: 'btn'
