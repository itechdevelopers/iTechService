<% if params[:container].present? %>
// The caller is already inside #modal_form, so the picker goes into a panel of
// its own instead of a second modal window.
var $container = $('<%= j params[:container] %>');
$container.html("<%= j(render('products/choose_inline_form')) %>");
product_groups_tree_readonly('<%= j params[:container] %> #product_groups');
$container.slideDown();

<% else %>
store_id = $('form [id$=store_id]').val();

if ($('#modal_form').length == 0) {
  $('body').append('<%= j(render('products/choose_form')) %>');
}

$('#modal_form form').attr('store_id', store_id);
$('#store_id').val(store_id);

if (store_id != '') {
  $('#modal_form #product_groups a').each(function () {
    $(this).attr('href', $(this).attr('href') + '&store_id=' + store_id);
  });
}

product_groups_tree_readonly('#product_groups');
$("#modal_form").modal('show');

<% if @product.present? %>
$('#product_choose_form').submit();
<% end %>
<% end %>
