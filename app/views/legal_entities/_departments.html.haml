%p.legal-entities-board__hint{ data: { idle: t('.hint_idle'), selected_template: t('.hint_selected') } }
  = t('.hint_idle')

.well.well-small.legal-entities-board__global
  %strong= t('.global_title')
  = render 'requisites', requisites: global_requisites, show_source: false

- departments.each do |department|
  .well.well-small.legal-entities-board__department
    .pull-right
      -# href и текст подтверждения подставляет legal_entities.js, когда слева выбрана организация
      = link_to t('.link'), '#', remote: true, method: :patch,
                class: 'btn btn-small btn-primary legal-entities-board__link-button',
                data: { url_template: link_legal_entity_path('__ID__', department_id: department.id),
                        confirm_template: t('.link_confirm', entity: '__ENTITY__', department: department.full_name),
                        linked_entity_id: department.legal_entity_id }
      - if department.legal_entity
        = link_to t('.unlink'), unlink_legal_entities_path(department_id: department.id),
                  remote: true, method: :patch, class: 'btn btn-small',
                  data: { confirm: t('.unlink_confirm', department: department.full_name) }
    %strong= department.full_name
    - if department.legal_entity
      %span.label.label-info= department.legal_entity.name
    = render 'requisites', requisites: requisites[department.id], show_source: true
