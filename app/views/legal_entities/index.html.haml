.page-header
  %h1= auto_title
  - if policy(LegalEntity).create?
    = link_to_new LegalEntity, t('.add'), remote: true

.row-fluid.legal-entities-board
  .span5
    %h4= t('.entities')
    #legal_entities_list= render 'entities', legal_entities: @legal_entities
  .span7
    %h4= t('.departments')
    #legal_entities_departments
      = render 'departments', departments: @departments, requisites: @requisites,
                              global_requisites: @global_requisites
