- if show_repair_top_bar?
  .subscriptions-bar
    .subscriptions-bar__scroll
      - in_progress_jobs = user_in_progress_service_jobs
      - if in_progress_jobs.any?
        .subscriptions-group.subscriptions-group--in-progress
          .subscriptions-group__label= t('.in_progress_devices')
          .subscriptions-group__list
            - in_progress_jobs.each do |service_job|
              = render 'shared/subscription_block', service_job: service_job,
                                                    modifier: 'subscription-block--in-progress'
      - user_paused_service_job_groups.each do |pause_reason, paused_jobs|
        .subscriptions-group.subscriptions-group--paused
          .subscriptions-group__label
            = t('.paused_devices')
            - if pause_reason
              %span.subscriptions-group__reason= pause_reason.name
          .subscriptions-group__list
            - paused_jobs.each do |service_job|
              = render 'shared/subscription_block', service_job: service_job,
                                                    modifier: 'subscription-block--paused'
    - favorite_jobs = user_favorite_service_jobs
    - if favorite_jobs.any?
      / Избранное свёрнуто в чип и вынесено из скроллящейся части: колонок пауз
      / бывает до восьми, и полноразмерная секция уезжала бы за край экрана.
      / Раскрывается по наведению влево — теми же карточками, что и в полосе.
      .subscriptions-bar__favorites
        %span.subscriptions-favorites-chip{ tabindex: 0, title: t('.favorite_devices') }
          = glyph('angle-left')
          = glyph('star')
          %span.subscriptions-favorites-chip__count= favorite_jobs.size
        .subscriptions-favorites-panel
          .subscriptions-group.subscriptions-group--favorites
            .subscriptions-group__label= t('.favorite_devices')
            .subscriptions-group__list
              - favorite_jobs.each do |service_job|
                = render 'shared/subscription_block', service_job: service_job
