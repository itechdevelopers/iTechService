-# Shared by the technician's task modal (hidden until the «Я сломал» checkbox)
-# and the standalone admin page (always visible).
- hidden = local_assigns.fetch(:hidden, !f.object.persisted?)
.fields.well.well-small.breakage-report__fields{class: ('hidden' if hidden)}
  - if f.object.errors.any?
    %p.text-error= f.object.errors.full_messages.join('. ')
  = f.input :user_id, required: true,
            collection: BreakageReport.possible_users(f.object.department, current_user, f.object.user),
            label_method: :short_name, value_method: :id,
            input_html: { class: 'breakage-report__user' }
  = f.input :circumstances, as: :text, required: true,
            input_html: { rows: 3, class: 'input-block-level',
                          placeholder: t('device_tasks.breakage_reports.circumstances_hint') }
  = f.input :resolution, as: :text, required: true,
            input_html: { rows: 2, class: 'input-block-level',
                          placeholder: t('device_tasks.breakage_reports.resolution_hint') }
  .control-group
    %label.control-label= BreakageReport.human_attribute_name :item
    .controls
      -# Same picker technicians already use for repair service spare parts:
      -# groups tree plus search. It renders inline because the task form itself
      -# occupies #modal_form.
      = f.hidden_field :item_id, id: 'breakage_report_item_id'
      %span#breakage_report_item_id_presentation.breakage-report__item
        = f.object.item_presentation
      = link_to t('device_tasks.breakage_reports.choose_item'),
                choose_products_path(form: 'breakage_report', store_kind: 'spare_parts', is_product_only: false,
                                     store_id: f.object.write_off_store&.id,
                                     container: '#breakage_item_choose_container',
                                     parent_input_id: 'breakage_report_item_id'),
                remote: true, class: 'btn btn-small'
      - if f.object.part_price.present?
        %span.help-inline
          = BreakageReport.human_attribute_name :part_price
          = human_currency f.object.part_price
      - if f.object.deduction_act.present?
        %span.help-inline
          = link_to t('breakage_reports.deduction_act', id: f.object.deduction_act_id),
                    deduction_act_path(f.object.deduction_act_id), target: '_blank'
      %span.help-block= t('breakage_reports.write_off_hint')

  -# Full width: inside .controls the group tree gets a quarter of a column.
  #breakage_item_choose_container.breakage-report__item-choose.hide
