%tr.inventories__row
  %td= link_to "№#{inventory.number}", inventory_path(inventory)
  %td= l inventory.created_at, format: :short
  %td= inventory.store&.name
  %td
    %span{ class: "inventories__status inventories__status--#{inventory.status.tr('_', '-')}" }
      = t("inventories.statuses.#{inventory.status}")
  %td= inventory.user&.short_name
  %td
    - if inventory.draft?
      = '—'
    - else
      = t('inventories.index.progress_value', counted: inventory.counted_lines_count, total: inventory.lines.size)
  %td.inventories__row-action
    -# Технарь видит в списке только номер и дату — работа начинается отсюда.
    - if policy(inventory).start?
      = link_to t('inventories.show.start'), start_inventory_path(inventory), method: :patch,
                data: { confirm: t('inventories.show.start_confirm') }, class: 'btn btn-small btn-primary'
