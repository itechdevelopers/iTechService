.inventories__summary
  %h4= t('inventories.selection.summary_title')
  - if inventory.selection?
    %p
      = t('inventories.selection.summary_counts',
          groups: inventory.selected_groups.size,
          products: inventory.selected_products.size)
    -# Считаем тем же сборщиком, что и сам список: обещанное число должно
    -# совпасть с полученным. Позиции, не заведённые на складе ревизии, и
    -# поэкземплярные сюда не попадают.
    %p.inventories__summary-total
      = t('inventories.selection.summary_total', count: InventoryLinesBuilder.preview_count(inventory))
    %p.inventories__hint
      = t('inventories.selection.summary_catalog', count: inventory.selected_products_scope.count)

    - names = inventory_selection_names(inventory)
    %ul.unstyled
      - names[:shown].each do |icon, name|
        %li= glyph(icon) + " #{name}"
    - if names[:rest].positive?
      %p.inventories__hint= t('inventories.selection.summary_rest', count: names[:rest])
  - else
    %p.inventories__hint= t('inventories.selection.summary_empty')
