.page-header
  = link_to t('.back', number: @inventory.number), inventory_path(@inventory), class: 'btn pull-right'
  %h2= t('.title', number: @inventory.number)

.row-fluid.inventories
  .span6
    %h4= t('.groups_title')
    %p.inventories__hint= t('.groups_hint')

    %ul.inventories__tree#groups_tree
      -# covered: false — у корня предков нет, а собственная отметка группы её
      -# же чекбокс не запирает, иначе снять её было бы нечем.
      = render partial: 'group_node', collection: @root_groups, as: :group,
               locals: { selected_ids: @inventory.selected_group_ids, inventory: @inventory,
                         covered: false, expandable_ids: expandable_group_ids(@root_groups) }

  .span6
    %h4= t('.products_title')
    %p.inventories__hint= t('.products_hint')

    -# remote: поиск подменяет только блок результатов, иначе дерево слева
    -# перерисовывалось бы целиком и уезжало в начало на каждый запрос.
    = form_tag selection_inventory_path(@inventory), method: :get, class: 'form-search', remote: true do
      .input-append
        = text_field_tag :q, params[:q], class: 'search-query input-medium', placeholder: t('.search_placeholder')
        %button.btn{ type: 'submit' }= glyph('search')

    #found_products= render 'found_products', inventory: @inventory, products: @found_products, query: params[:q]

    #selection_summary= render 'selection_summary', inventory: @inventory

-# Каждая галочка уходит на сервер отдельным запросом и несёт своё состояние:
-# сабмит формы отправил бы только те чекбоксы, что сейчас есть в DOM, а дерево
-# раскрывается по веткам. CSRF-токен подставляет jquery_ujs своим
-# ajaxPrefilter — в проекте подключён он, глобального Rails нет.
:javascript
  $(function() {
    // Ветка грузится один раз: дальше стрелка просто прячет и показывает уже
    // полученную разметку, иначе повторное раскрытие затирало бы галочки,
    // которые товаровед успел поставить внутри ветки.
    $('#groups_tree').on('click', '.inventories__tree-toggle', function(e) {
      e.preventDefault();
      var toggle = $(this);
      var box = $('#' + toggle.data('target'));

      if (toggle.data('loaded')) {
        box.toggle();
      } else {
        toggle.data('loaded', true);
        box.show();
        $.get(toggle.data('url'));
      }

      toggle.toggleClass('inventories__tree-toggle--open', box.is(':visible'));
    });

    $('#groups_tree').on('change', '.inventories__tree-check', function() {
      var box = $(this);
      var data = { selected: box.is(':checked') ? 1 : 0 };

      if (box.data('group')) {
        data.group_id = box.data('group');
        // Отметка группы меняет смысл всего, что внутри: позиции ветки уходят
        // в ревизию через неё. Уже загруженную ветку схлопываем, чтобы она не
        // осталась на экране с прежними — теперь неверными — галочками.
        var node = box.closest('.inventories__tree-node');
        node.find('.inventories__tree-children').empty().hide();
        node.find('.inventories__tree-toggle').removeData('loaded')
            .removeClass('inventories__tree-toggle--open');
      } else {
        data.product_id = box.data('product');
      }

      $.ajax({ url: box.data('url'), type: 'PATCH', dataType: 'script', data: data });
    });
  });
