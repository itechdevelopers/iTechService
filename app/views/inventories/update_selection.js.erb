$('#selection_summary').html('<%= j render "selection_summary", inventory: @inventory %>');
<% @state_updates.each do |node| %>
inventorySelection.setState('<%= node[:type] %>', <%= node[:id] %>, '<%= node[:state] %>');
<% end %>
<% if params[:product_id].present? %>
  <%# Позиция может входить в ревизию через отметку на группе, поэтому кнопка
      смотрит на действующее состояние, а не на собственную отметку. %>
  <% selected = @inventory.selected?(Product.find_by(id: params[:product_id])) %>
  $('#product_toggle_<%= params[:product_id] %>').html('<%= j (selected ? glyph("minus") : glyph("plus")) %>');
<% end %>
