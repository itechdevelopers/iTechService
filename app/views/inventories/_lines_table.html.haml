- editable = policy(inventory).manage_lines?
- countable = policy(inventory).count_lines?
- reviewing = policy(inventory).review?
-# При пересчёте технарь видит только возвращённые позиции — остальные он уже
-# посчитал, и показывать их значило бы предлагать пересчитать всё заново.
-# Товароведу список урезать нельзя: он разбирает ревизию целиком, а админ
-# проходит обе проверки сразу.
- lines = (countable && !reviewing) ? inventory.lines_to_count : inventory.lines
- columns = 6 + [reviewing ? 2 : 0, (editable || countable || reviewing) ? 1 : 0].sum

.inventories__lines-header
  %h4
    = t('inventories.show.lines_title')
    %small#lines_progress= inventory_lines_progress(inventory)
  - if policy(inventory).build_lines?
    -# Пересборка стирает ручные правки списка, поэтому подтверждение
    -# спрашиваем только когда стирать уже есть что.
    = link_to build_lines_inventory_path(inventory), method: :post,
              data: { confirm: (t('inventories.show.rebuild_confirm') if inventory.lines.any?) },
              class: 'btn btn-primary btn-small' do
      = inventory.lines.any? ? t('inventories.show.rebuild_lines') : t('inventories.show.build_lines')

- if countable
  %p.inventories__hint= t(inventory.recount? ? 'inventories.show.recount_hint' : 'inventories.show.counting_hint')
- if reviewing
  %p.inventories__hint= t('inventories.show.review_hint', count: inventory.discrepancy_lines.count)

- table_locals = { inventory: inventory, lines: lines, columns: columns,
                   editable: editable, countable: countable, reviewing: reviewing }

-# Форму разбора вешаем только на режим товароведа: при подсчёте у каждой
-# строки своя форма автосохранения, а вложенные формы браузер выбрасывает.
- if policy(inventory).request_recount?
  = form_tag request_recount_inventory_path(inventory), method: :patch, id: 'inventory_review_form' do
    = render 'inventories/lines_body', table_locals
    .inventories__review-actions
      = submit_tag t('inventories.show.request_recount'), class: 'btn btn-warning',
                   data: { confirm: t('inventories.show.request_recount_confirm') }
      -# formaction: все кнопки работают с одним набором чекбоксов, но ведут в
      -# разные экшены — второй набор галочек для того же списка только запутал бы.
      = submit_tag t('inventories.show.accept_shortages'), class: 'btn btn-danger',
                   formaction: accept_shortages_inventory_path(inventory),
                   data: { confirm: t('inventories.show.accept_shortages_confirm') }
      %span.inventories__hint= t('inventories.show.review_actions_hint')

    .inventories__review-actions
      = select_tag :surplus_store_id,
                   options_from_collection_for_select(Store.visible, 'id', 'name'),
                   include_blank: t('inventories.show.surplus_store_blank'), class: 'input-large'
      = submit_tag t('inventories.show.accept_surplus'), class: 'btn btn-info',
                   formaction: accept_surplus_inventory_path(inventory),
                   data: { confirm: t('inventories.show.accept_surplus_confirm') }
      %span.inventories__hint= t('inventories.show.accept_surplus_hint')
- else
  = render 'inventories/lines_body', table_locals

- if countable
  #submit_box= render 'inventories/submit_box', inventory: inventory
