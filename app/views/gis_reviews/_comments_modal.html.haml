-# Модалка «все комментарии отзыва». Открывается часиками из колонки комментариев
-# (контроллер #comments → shared/show_modal_form, form_name=comments_modal).
.modal-header
  = button_to_close_modal
  %h3= t('gis_reviews.comments_modal.title')

.modal-body
  - if @gis_review.comments.any?
    .comments_list= comments_list_for @gis_review
  - else
    %p.muted= t('gis_reviews.comments_modal.empty')

.modal-footer
  = link_to t('helpers.links.close'), '#', 'data-dismiss' => 'modal', class: 'btn'
