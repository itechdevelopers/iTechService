<div class="kanban-card thumbnail" data-card-id="<%= card.id %>">
  <%= link_to card.name, kanban_card_path(card) %>
  <div class="kanban-card-info">
    <% if card.managers.present? %>
      <%= t(".manager_person", name: card.managers.map(&:presentation).join(", ")) %>
    <% end %>
    <% if card.deadline.present? %>
      <div class="kanban-deadline">
        <%= t(".deadline", date: card.deadline.strftime("%d.%m.%Y")) %>
      </div>
    <% end %>
    <% if local_assigns[:money_tracking] && card.money_entries.any? %>
      <div class="kanban-card-money">
        <%= t(".money", amount: number_to_currency(card.money_total, unit: '₽', format: '%n %u', delimiter: ' ', precision: 0)) %>
      </div>
    <% end %>
  </div>
</div>
