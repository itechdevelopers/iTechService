<%# Единственный авторитетный источник состояния иконки уведомлений. %>
<%# Сбрасываем все цветовые модификаторы и ставим актуальный — так путь %>
<%# работает одинаково при загрузке страницы и при realtime-перерисовке. %>
$("#user_notifications").removeClass("active-notifications <%= NotificationCatalog::COLORS.map { |color| "active-notifications--#{color}" }.join(' ') %>");

<% if @notifications.present? %>
  $("#user_notifications").addClass("active-notifications active-notifications--<%= @icon_color %>");
  $("#user_notifications").attr("data-content", "<%= j render(collection: @notifications, partial: "short_notification", as: :notification, locals: { preferences: @preferences }) %>");
<% else %>
  $("#user_notifications").attr("data-content", "");
<% end %>
