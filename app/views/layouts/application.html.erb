<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="x-ua-compatible" content="IE=Edge,chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="apple-touch-icon-precomposed" href="images/logo.png">
  <%= favicon_link_tag 'logo.png' %>

  <title><%= content_for?(:title) ? "iTech Service | #{yield(:title)}" : 'iTech Service' %></title>

  <%= stylesheet_link_tag 'application', :media => 'all', 'data-turbolinks-track' => true %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <%= csrf_meta_tags %>
</head>

<body>
  <div id="modal" class="modal large hide fade"></div>
  <% if user_signed_in? %>
    <%= render 'shared/topbar' %>
    <% if policy(:telephony).use? %>
      <div class="container-fluid ais-telephony-launcher">
        <%= link_to "☎ Телефония · #{current_user.telephony_extension}", telephony_workspace_path(path: request.fullpath), class: 'btn btn-small' %>
        <%= link_to 'Отдельное окно', telephony_path, class: 'btn btn-small', target: 'ais-telephony', onclick: "window.open(this.href, 'ais-telephony', 'width=460,height=740,resizable=yes,scrollbars=yes'); return false;" %>
      </div>
      <script>try { if (window.parent !== window && window.parent.AisTelephonyWorkspace) document.querySelector('.ais-telephony-launcher').hidden = true; } catch (e) {}</script>
    <% end %>
    <%= render 'shared/navbar' %>
    <%= render 'shared/elqueue_service_widget' if current_user.working_electronic_queue? %>
    <%= render 'shared/user_subscriptions' %>
    <%= render 'shared/flash_messages' %>
    <%= spinner_tag %>
    <%= render 'shared/notifications' %>

    <div class="container-fluid">
      <div id="flash_place">
        <%= bootstrap_flash %>
      </div>
      <div class="row-fluid">
        <div class="span12">
          <div id="main_content">
            <%= yield %>
          </div>
        </div>
      </div>
    </div>

    <%#TODO implement via cable subscribe_to '/announcements' %>
    <%#TODO implement via cable subscribe_to '/service_jobs/new' %>
    <%#TODO implement via cable subscribe_to '/service_jobs/update' %>
  <% else %>
    <%= yield %>
  <% end %>
  <%= render 'shared/scanner' %>
</body>
</html>
